{
  "name": "Mencherz · Aeroplane Chess",
  "short_name": "Mencherz",
  "description": "Aeroplane Chess with friends, online or on one tablet",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#2d86dc",
  "theme_color": "#2f8fe6",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
